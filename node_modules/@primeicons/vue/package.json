{
  "name": "@primeicons/vue",
  "version": "8.0.2",
  "author": "PrimeTek Informatics",
  "homepage": "https://primeicons.dev/",
  "description": "PrimeIcons for Vue 3 - 300+ customizable SVG icons as Vue components",
  "keywords": [
    "primeicons",
    "vue",
    "vue3",
    "icons",
    "svg-icons",
    "vue-icons",
    "icon-components"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primefaces/primeicons-nextchapter.git",
    "directory": "packages/@primeicons/vue"
  },
  "bugs": {
    "url": "https://support.primeui.dev"
  },
  "main": "./dist/esm/index.mjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/lib/core/index.d.ts",
      "import": "./dist/esm/core/index.mjs",
      "default": "./dist/esm/core/index.mjs"
    },
    "./*": {
      "types": "./dist/lib/icons/*.d.ts",
      "import": "./dist/esm/icons/*.mjs",
      "default": "./dist/esm/icons/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@primeuix/utils": "^0.8.0",
    "@primeicons/core": "8.0.2"
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "devDependencies": {
    "vue-tsc": "^3",
    "vite-plugin-dts": "^4"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
    "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:dev:package",
    "build:package": "pnpm run build:prebuild && vite build",
    "build:dev:package": "pnpm run build:prebuild && vite build --watch",
    "build:prebuild": "node ./scripts/prebuild.mjs",
    "build:postbuild": "node ./scripts/postbuild.mjs",
    "type:check": "vue-tsc --noEmit -p ./tsconfig.json",
    "dev:link": "pnpm link --global && npm link"
  }
}